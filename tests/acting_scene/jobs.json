[{"text": "Okay, so here's how it works. In Japan, everything costs thousands. Thousands! So the yen must be super valuable.", "ref": "tests/benny_voice/ref_B1.wav", "emotion": "confident", "out": "tests/acting_scene/raw0.wav", "takes": 3}, {"text": "...What? Why are you doing the eyebrow?", "ref": "tests/benny_voice/ref_B1.wav", "emotion": "confused", "out": "tests/acting_scene/raw2.wav", "takes": 3}, {"text": "Benny. It's the opposite. Prices look big because each yen is tiny. One yen is a little over half a cent.", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/maya/reference.wav", "emotion": "sarcastic", "out": "tests/acting_scene/raw3.wav", "takes": 3}, {"text": "Half a... cent?", "ref": "tests/benny_voice/ref_B1.wav", "emotion": "confused", "out": "tests/acting_scene/raw4.wav", "takes": 3}, {"text": "So I've been bragging about being rich... in pennies.", "ref": "tests/benny_voice/ref_B1.wav", "emotion": "sad", "out": "tests/acting_scene/raw5.wav", "takes": 3}, {"text": "Tiny pennies, Benny.", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/maya/reference.wav", "emotion": "happy", "out": "tests/acting_scene/raw6.wav", "takes": 3}, {"text": "Okay, but they're very nice pennies. Some of them have holes in them!", "ref": "tests/benny_voice/ref_B1.wav", "emotion": "confident", "out": "tests/acting_scene/raw7.wav", "takes": 3}]