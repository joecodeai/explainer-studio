[{"text": "Okay, so here's how it works. In Japan, everything costs thousands. Thousands! So the yen must be super valuable.", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "confident", "out": "tests/benny_voice/A_current/raw0.wav", "takes": 3}, {"text": "...What? Why are you doing the eyebrow?", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "confused", "out": "tests/benny_voice/A_current/raw1.wav", "takes": 3}, {"text": "Less than... one cent?", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "confused", "out": "tests/benny_voice/A_current/raw2.wav", "takes": 3}, {"text": "So I've been bragging about being rich... in pennies.", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "sad", "out": "tests/benny_voice/A_current/raw3.wav", "takes": 3}, {"text": "Okay, but they're very nice pennies. Some of them have holes in them!", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "happy", "out": "tests/benny_voice/A_current/raw4.wav", "takes": 3}, {"text": "Don't tell the chef. I tried to tip him with them.", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "neutral", "out": "tests/benny_voice/A_current/raw5.wav", "takes": 3}, {"text": "Wait, wait, wait. So Japan is on sale? Like, the whole country?", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "excited", "out": "tests/benny_voice/A_current/raw6.wav", "takes": 3}, {"text": "Alright. When the dollar gets stronger, every dollar turns into more yen. That part I actually get.", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "neutral", "out": "tests/benny_voice/A_current/raw7.wav", "takes": 3}, {"text": "See? I know things. Write that down.", "ref": "/home/mundax/Documents/REL/ExplainerStudio/library/voices/benny/reference.wav", "emotion": "happy", "out": "tests/benny_voice/A_current/raw8.wav", "takes": 3}]