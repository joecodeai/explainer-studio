Dialogue: 0,0:06:32.12,0:06:33.12,C,,0,0,0,,SAY THEY WANT
Dialogue: 0,0:06:33.12,0:06:34.12,C,,0,0,0,,TO GET MARRIED
Dialogue: 0,0:06:34.12,0:06:34.70,C,,0,0,0,,SOMEDAY.
Dialogue: 0,0:06:34.84,0:06:35.66,C,,0,0,0,,SO MOST YOUNG
Dialogue: 0,0:06:35.66,0:06:36.78,C,,0,0,0,,PEOPLE AREN'T REJECTING
Dialogue: 0,0:06:36.78,0:06:37.76,C,,0,0,0,,MARRIAGE.
Dialogue: 0,0:06:37.76,0:06:39.18,C,,0,0,0,,THEY'RE POSTPONING IT.
Dialogue: 0,0:06:39.18,0:06:39.52,C,,0,0,0,,WHICH IS A
Dialogue: 0,0:06:39.52,0:06:40.88,C,,0,0,0,,VERY DIFFERENT THING,
Dialogue: 0,0:06:40.88,0:06:41.42,C,,0,0,0,,EVEN IF YOUR
Dialogue: 0,0:06:41.42,0:06:42.28,C,,0,0,0,,MUM CAN'T TELL
Dialogue: 0,0:06:42.28,0:06:42.97,C,,0,0,0,,THE DIFFERENCE.
Dialogue: 0,0:06:43.28,0:06:44.02,C,,0,0,0,,DIVORCE IS FALLING
Dialogue: 0,0:06:44.02,0:06:44.72,C,,0,0,0,,TOO.
Dialogue: 0,0:06:44.72,0:06:45.92,C,,0,0,0,,IN 1980,
Dialogue: 0,0:06:45.92,0:06:46.72,C,,0,0,0,,ABOUT TWENTY-THREE IN
Dialogue: 0,0:06:46.72,0:06:47.72,C,,0,0,0,,EVERY THOUSAND MARRIED
Dialogue: 0,0:06:47.72,0:06:48.76,C,,0,0,0,,AMERICAN WOMEN DIVORCED
Dialogue: 0,0:06:48.76,0:06:49.54,C,,0,0,0,,EACH YEAR.
Dialogue: 0,0:06:49.54,0:06:50.56,C,,0,0,0,,BY 2024,
Dialogue: 0,0:06:50.56,0:06:50.88,C,,0,0,0,,IT WAS ABOUT
Dialogue: 0,0:06:50.88,0:06:51.47,C,,0,0,0,,FOURTEEN.
Dialogue: 0,0:06:51.67,0:06:52.65,C,,0,0,0,,THE FAMOUS IDEA
Dialogue: 0,0:06:52.65,0:06:53.37,C,,0,0,0,,THAT HALF OF
Dialogue: 0,0:06:53.37,0:06:54.51,C,,0,0,0,,ALL MARRIAGES END
Dialogue: 0,0:06:54.51,0:06:55.41,C,,0,0,0,,IN DIVORCE IS
Dialogue: 0,0:06:55.41,0:06:56.49,C,,0,0,0,,OUT OF DATE.
Dialogue: 0,0:06:56.49,0:06:57.27,C,,0,0,0,,PEOPLE WHO MARRY
Dialogue: 0,0:06:57.27,0:06:57.69,C,,0,0,0,,LATER,
Dialogue: 0,0:06:57.69,0:06:58.89,C,,0,0,0,,AND MORE CAREFULLY,
Dialogue: 0,0:06:58.89,0:06:59.75,C,,0,0,0,,TEND TO STAY
Dialogue: 0,0:06:59.75,0:07:00.34,C,,0,0,0,,MARRIED.
Dialogue: 0,0:07:00.49,0:07:01.45,C,,0,0,0,,PEW ALSO FOUND
Dialogue: 0,0:07:01.45,0:07:02.39,C,,0,0,0,,THAT MARRIED ADULTS
Dialogue: 0,0:07:02.39,0:07:02.95,C,,0,0,0,,ARE,
Dialogue: 0,0:07:02.95,0:07:04.09,C,,0,0,0,,ON AVERAGE,
Dialogue: 0,0:07:04.09,0:07:05.05,C,,0,0,0,,MORE SATISFIED WITH
Dialogue: 0,0:07:05.05,0:07:06.29,C,,0,0,0,,THEIR RELATIONSHIPS AND
Dialogue: 0,0:07:06.29,0:07:07.09,C,,0,0,0,,MORE TRUSTING OF
Dialogue: 0,0:07:07.09,0:07:07.91,C,,0,0,0,,THEIR PARTNERS THAN
Dialogue: 0,0:07:07.91,0:07:08.71,C,,0,0,0,,PEOPLE WHO LIVE
Dialogue: 0,0:07:08.71,0:07:10.33,C,,0,0,0,,TOGETHER WITHOUT MARRYING.
Dialogue: 0,0:07:10.33,0:07:10.79,C,,0,0,0,,THOUGH THAT MAY
Dialogue: 0,0:07:10.79,0:07:11.71,C,,0,0,0,,PARTLY BE BECAUSE
Dialogue: 0,0:07:11.71,0:07:12.57,C,,0,0,0,,THE HAPPIEST COUPLES
Dialogue: 0,0:07:12.57,0:07:13.15,C,,0,0,0,,ARE THE ONES
Dialogue: 0,0:07:13.15,0:07:13.82,C,,0,0,0,,WHO MARRY.
Dialogue: 0,0:07:13.93,0:07:14.92,C,,0,0,0,,MARRIAGE ALSO STILL
Dialogue: 0,0:07:14.92,0:07:15.57,C,,0,0,0,,MATTERS LEGALLY.
Dialogue: 0,0:07:15.57,0:07:16.23,C,,0,0,0,,IN ENGLAND,
Dialogue: 0,0:07:16.23,0:07:17.21,C,,0,0,0,,LOTS OF PEOPLE
Dialogue: 0,0:07:17.21,0:07:18.19,C,,0,0,0,,BELIEVE IN SOMETHING
Dialogue: 0,0:07:18.19,0:07:19.17,C,,0,0,0,,CALLED COMMON-LAW MARRIAGE,
Dialogue: 0,0:07:19.17,0:07:20.16,C,,0,0,0,,THE IDEA THAT
Dialogue: 0,0:07:20.16,0:07:21.14,C,,0,0,0,,LIVING TOGETHER LONG
Dialogue: 0,0:07:21.14,0:07:22.12,C,,0,0,0,,ENOUGH GIVES YOU
Dialogue: 0,0:07:22.12,0:07:23.10,C,,0,0,0,,THE SAME RIGHTS
Dialogue: 0,0:07:23.10,0:07:24.09,C,,0,0,0,,AS A MARRIED
Dialogue: 0,0:07:24.09,0:07:24.66,C,,0,0,0,,COUPLE.
Dialogue: 0,0:07:24.87,0:07:26.25,C,,0,0,0,,IT DOESN'T EXIST.
Dialogue: 0,0:07:26.25,0:07:27.17,C,,0,0,0,,COUPLES WHO SPLIT
Dialogue: 0,0:07:27.17,0:07:27.93,C,,0,0,0,,UP OR LOSE
Dialogue: 0,0:07:27.93,0:07:28.79,C,,0,0,0,,A PARTNER AFTER
Dialogue: 0,0:07:28.79,0:07:30.19,C,,0,0,0,,DECADES TOGETHER CAN
Dialogue: 0,0:07:30.19,0:07:30.85,C,,0,0,0,,FIND THEY HAVE
Dialogue: 0,0:07:30.85,0:07:31.95,C,,0,0,0,,FAR FEWER RIGHTS
Dialogue: 0,0:07:31.95,0:07:33.19,C,,0,0,0,,THAN THEY ASSUMED.
Dialogue: 0,0:07:33.19,0:07:33.63,C,,0,0,0,,WHICH IS A
Dialogue: 0,0:07:33.63,0:07:34.59,C,,0,0,0,,TERRIBLE TIME TO
Dialogue: 0,0:07:34.59,0:07:35.42,C,,0,0,0,,FIND OUT.
Dialogue: 0,0:07:35.50,0:07:36.47,C,,0,0,0,,AND IF MARRIAGE
Dialogue: 0,0:07:36.47,0:07:37.44,C,,0,0,0,,WERE TRULY OBSOLETE,
Dialogue: 0,0:07:37.44,0:07:38.41,C,,0,0,0,,IT WOULD BE
Dialogue: 0,0:07:38.41,0:07:39.38,C,,0,0,0,,STRANGE FOR SO
Dialogue: 0,0:07:39.38,0:07:40.36,C,,0,0,0,,MANY PEOPLE TO
Dialogue: 0,0:07:40.36,0:07:41.33,C,,0,0,0,,HAVE FOUGHT FOR
Dialogue: 0,0:07:41.33,0:07:42.30,C,,0,0,0,,THE RIGHT TO
Dialogue: 0,0:07:42.30,0:07:42.94,C,,0,0,0,,DO IT.
Dialogue: 0,0:07:42.94,0:07:43.92,C,,0,0,0,,THE NETHERLANDS LEGALISED
Dialogue: 0,0:07:43.92,0:07:44.89,C,,0,0,0,,SAME-SEX MARRIAGE IN
Dialogue: 0,0:07:44.89,0:07:45.21,C,,0,0,0,,2001.
Dialogue: 0,0:07:45.21,0:07:46.18,C,,0,0,0,,THE UNITED STATES
Dialogue: 0,0:07:46.18,0:07:47.15,C,,0,0,0,,DID IT NATIONWIDE
Dialogue: 0,0:07:47.15,0:07:48.05,C,,0,0,0,,IN 2015.
Dialogue: 0,0:07:48.41,0:07:49.05,C,,0,0,0,,EVEN IN SOUTH
Dialogue: 0,0:07:49.05,0:07:49.79,C,,0,0,0,,KOREA,
Dialogue: 0,0:07:49.79,0:07:50.31,C,,0,0,0,,WHERE MARRIAGE HAD
Dialogue: 0,0:07:50.31,0:07:50.91,C,,0,0,0,,BEEN FALLING FOR
Dialogue: 0,0:07:50.91,0:07:51.61,C,,0,0,0,,YEARS,
Dialogue: 0,0:07:51.61,0:07:52.65,C,,0,0,0,,IT BOUNCED BACK.
Dialogue: 0,0:07:52.65,0:07:53.67,C,,0,0,0,,MARRIAGES ROSE ALMOST
Dialogue: 0,0:07:53.67,0:07:54.71,C,,0,0,0,,FIFTEEN PERCENT IN
Dialogue: 0,0:07:54.71,0:07:55.69,C,,0,0,0,,2024,
Dialogue: 0,0:07:55.69,0:07:56.31,C,,0,0,0,,THE BIGGEST JUMP
Dialogue: 0,0:07:56.31,0:07:57.09,C,,0,0,0,,ON RECORD,
Dialogue: 0,0:07:57.09,0:07:57.67,C,,0,0,0,,AND ROSE AGAIN
Dialogue: 0,0:07:57.67,0:07:58.76,C,,0,0,0,,IN 2025.
Dialogue: 0,0:07:59.09,0:07:59.97,C,,0,0,0,,TURNS OUT,
Dialogue: 0,0:07:59.97,0:08:00.55,C,,0,0,0,,LOVE IS NOT
Dialogue: 0,0:08:00.55,0:08:01.39,C,,0,0,0,,DEAD.
Dialogue: 0,0:08:01.39,0:08:02.54,C,,0,0,0,,JUST RUNNING LATE.
Dialogue: 0,0:08:02.66,0:08:03.06,C,,0,0,0,,SO,
Dialogue: 0,0:08:03.06,0:08:03.76,C,,0,0,0,,IS MARRIAGE BECOMING
Dialogue: 0,0:08:03.76,0:08:04.41,C,,0,0,0,,OBSOLETE?
Dialogue: 0,0:08:04.57,0:08:05.97,C,,0,0,0,,NOT EXACTLY.
Dialogue: 0,0:08:05.97,0:08:07.31,C,,0,0,0,,WHAT'S BECOMING OBSOLETE
Dialogue: 0,0:08:07.31,0:08:08.35,C,,0,0,0,,IS MARRIAGE AS
Dialogue: 0,0:08:08.35,0:08:09.59,C,,0,0,0,,A REQUIREMENT.
Dialogue: 0,0:08:09.59,0:08:10.27,C,,0,0,0,,THE IDEA THAT
Dialogue: 0,0:08:10.27,0:08:10.74,C,,0,0,0,,YOU HAVE TO
Dialogue: 0,0:08:10.74,0:08:11.38,C,,0,0,0,,MARRY TO BE
Dialogue: 0,0:08:11.38,0:08:12.24,C,,0,0,0,,AN ADULT,
Dialogue: 0,0:08:12.24,0:08:13.47,C,,0,0,0,,TO BE RESPECTABLE,
Dialogue: 0,0:08:13.47,0:08:14.44,C,,0,0,0,,TO HAVE MONEY,
Dialogue: 0,0:08:14.44,0:08:14.80,C,,0,0,0,,OR TO RAISE
Dialogue: 0,0:08:14.80,0:08:15.46,C,,0,0,0,,A FAMILY.
Dialogue: 0,0:08:15.68,0:08:16.66,C,,0,0,0,,IT'S ALSO BECOMING
Dialogue: 0,0:08:16.66,0:08:17.31,C,,0,0,0,,MORE FLEXIBLE.
Dialogue: 0,0:08:17.31,0:08:17.96,C,,0,0,0,,IN 2019,
Dialogue: 0,0:08:17.96,0:08:18.94,C,,0,0,0,,BRITAIN OPENED CIVIL
Dialogue: 0,0:08:18.94,0:08:19.92,C,,0,0,0,,PARTNERSHIPS TO OPPOSITE-SEX
Dialogue: 0,0:08:19.92,0:08:20.24,C,,0,0,0,,COUPLES,
Dialogue: 0,0:08:20.24,0:08:21.22,C,,0,0,0,,AFTER ONE COUPLE
Dialogue: 0,0:08:21.22,0:08:22.19,C,,0,0,0,,WHO WANTED THE
Dialogue: 0,0:08:22.19,0:08:23.17,C,,0,0,0,,LEGAL PROTECTION WITHOUT
Dialogue: 0,0:08:23.17,0:08:24.15,C,,0,0,0,,THE TRADITIONAL BAGGAGE
Dialogue: 0,0:08:24.15,0:08:25.12,C,,0,0,0,,TOOK THEIR CASE
Dialogue: 0,0:08:25.12,0:08:26.10,C,,0,0,0,,ALL THE WAY
Dialogue: 0,0:08:26.10,0:08:27.08,C,,0,0,0,,TO THE SUPREME
Dialogue: 0,0:08:27.08,0:08:27.65,C,,0,0,0,,COURT.
Dialogue: 0,0:08:27.79,0:08:28.51,C,,0,0,0,,SO THE FUTURE
Dialogue: 0,0:08:28.51,0:08:29.39,C,,0,0,0,,MAY LOOK LESS
Dialogue: 0,0:08:29.39,0:08:30.33,C,,0,0,0,,LIKE ONE FIXED
Dialogue: 0,0:08:30.33,0:08:30.85,C,,0,0,0,,TEMPLATE,
Dialogue: 0,0:08:30.85,0:08:31.73,C,,0,0,0,,AND MORE LIKE
Dialogue: 0,0:08:31.73,0:08:32.55,C,,0,0,0,,A MENU.
Dialogue: 0,0:08:32.55,0:08:33.38,C,,0,0,0,,MARRIAGE,
Dialogue: 0,0:08:33.38,0:08:34.21,C,,0,0,0,,PARTNERSHIP,
Dialogue: 0,0:08:34.21,0:08:35.29,C,,0,0,0,,LIVING TOGETHER,
Dialogue: 0,0:08:35.29,0:08:36.37,C,,0,0,0,,LIVING APART.
Dialogue: 0,0:08:36.37,0:08:36.99,C,,0,0,0,,WITH THE SAME
Dialogue: 0,0:08:36.99,0:08:38.40,C,,0,0,0,,QUESTION UNDERNEATH ALL
Dialogue: 0,0:08:38.40,0:08:39.09,C,,0,0,0,,OF THEM: WHO
Dialogue: 0,0:08:39.09,0:08:39.79,C,,0,0,0,,DO YOU ACTUALLY
Dialogue: 0,0:08:39.79,0:08:40.49,C,,0,0,0,,WANT TO BUILD
Dialogue: 0,0:08:40.49,0:08:41.44,C,,0,0,0,,A LIFE WITH?
Dialogue: 0,0:08:41.42,0:08:42.30,C,,0,0,0,,WHAT'S LEFT IS
Dialogue: 0,0:08:42.30,0:08:43.32,C,,0,0,0,,MARRIAGE AS A
Dialogue: 0,0:08:43.32,0:08:44.28,C,,0,0,0,,CHOICE.
Dialogue: 0,0:08:44.28,0:08:45.38,C,,0,0,0,,FEWER PEOPLE MAKE
Dialogue: 0,0:08:45.38,0:08:45.92,C,,0,0,0,,IT,
Dialogue: 0,0:08:45.92,0:08:46.48,C,,0,0,0,,AND THEY MAKE
Dialogue: 0,0:08:46.48,0:08:47.62,C,,0,0,0,,IT LATER.
Dialogue: 0,0:08:47.62,0:08:48.12,C,,0,0,0,,BUT THE ONES
Dialogue: 0,0:08:48.12,0:08:49.06,C,,0,0,0,,WHO DO SEEM
Dialogue: 0,0:08:49.06,0:08:49.62,C,,0,0,0,,TO MEAN IT
Dialogue: 0,0:08:49.62,0:08:50.21,C,,0,0,0,,MORE.
Dialogue: 0,0:08:50.39,0:08:50.95,C,,0,0,0,,SO,
Dialogue: 0,0:08:50.95,0:08:51.67,C,,0,0,0,,NOT DEAD.
Dialogue: 0,0:08:51.67,0:08:52.46,C,,0,0,0,,JUST PICKIER.
Dialogue: 0,0:08:52.54,0:08:53.40,C,,0,0,0,,IN A WAY,
Dialogue: 0,0:08:53.40,0:08:54.06,C,,0,0,0,,IT'S GONE BACK
Dialogue: 0,0:08:54.06,0:08:54.52,C,,0,0,0,,TO WHAT THE
Dialogue: 0,0:08:54.52,0:08:55.82,C,,0,0,0,,OLD ROMANTICS WANTED
Dialogue: 0,0:08:55.82,0:08:57.08,C,,0,0,0,,ALL ALONG.
Dialogue: 0,0:08:57.08,0:08:58.42,C,,0,0,0,,MARRYING FOR LOVE,
Dialogue: 0,0:08:58.42,0:08:59.08,C,,0,0,0,,INSTEAD OF FOR
Dialogue: 0,0:08:59.08,0:08:59.80,C,,0,0,0,,LAND,
Dialogue: 0,0:08:59.80,0:09:00.46,C,,0,0,0,,MONEY OR A
Dialogue: 0,0:09:00.46,0:09:01.77,C,,0,0,0,,FUNCTIONING BANK ACCOUNT.
Dialogue: 0,0:09:01.93,0:09:02.55,C,,0,0,0,,TELL US IN
Dialogue: 0,0:09:02.55,0:09:03.61,C,,0,0,0,,THE COMMENTS: IS
Dialogue: 0,0:09:03.61,0:09:04.77,C,,0,0,0,,MARRIAGE STILL WORTH
Dialogue: 0,0:09:04.77,0:09:05.49,C,,0,0,0,,IT?
Dialogue: 0,0:09:05.49,0:09:06.73,C,,0,0,0,,AND SUBSCRIBE.
Dialogue: 0,0:09:06.73,0:09:07.23,C,,0,0,0,,IT'S A LOT
Dialogue: 0,0:09:07.23,0:09:08.01,C,,0,0,0,,CHEAPER THAN A
Dialogue: 0,0:09:08.01,0:09:08.52,C,,0,0,0,,WEDDING.
