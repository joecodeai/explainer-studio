Dialogue: 0,0:09:51.22,0:09:52.01,C,,0,0,0,,LESS LIKELY.
Dialogue: 0,0:09:52.18,0:09:52.92,C,,0,0,0,,BUT THOSE CHOICES
Dialogue: 0,0:09:52.92,0:09:53.58,C,,0,0,0,,ARE MADE ON
Dialogue: 0,0:09:53.58,0:09:54.54,C,,0,0,0,,A VERY UNEVEN
Dialogue: 0,0:09:54.54,0:09:55.22,C,,0,0,0,,BOARD.
Dialogue: 0,0:09:55.22,0:09:56.46,C,,0,0,0,,WHERE YOU'RE BORN,
Dialogue: 0,0:09:56.46,0:09:56.96,C,,0,0,0,,WHERE YOU GROW
Dialogue: 0,0:09:56.96,0:09:57.40,C,,0,0,0,,UP,
Dialogue: 0,0:09:57.40,0:09:58.06,C,,0,0,0,,WHAT HAPPENS TO
Dialogue: 0,0:09:58.06,0:09:58.62,C,,0,0,0,,YOU,
Dialogue: 0,0:09:58.62,0:09:59.32,C,,0,0,0,,AND WHAT POVERTY
Dialogue: 0,0:09:59.32,0:10:00.56,C,,0,0,0,,ITSELF COSTS ALL
Dialogue: 0,0:10:00.56,0:10:01.42,C,,0,0,0,,SHAPE THE OPTIONS
Dialogue: 0,0:10:01.42,0:10:02.72,C,,0,0,0,,BEFORE ANYONE DECIDES
Dialogue: 0,0:10:02.72,0:10:03.29,C,,0,0,0,,ANYTHING.
Dialogue: 0,0:10:03.52,0:10:04.40,C,,0,0,0,,AND BEING POOR
Dialogue: 0,0:10:04.40,0:10:05.62,C,,0,0,0,,MAKES GOOD DECISIONS
Dialogue: 0,0:10:05.62,0:10:06.80,C,,0,0,0,,HARDER AND BAD
Dialogue: 0,0:10:06.80,0:10:08.42,C,,0,0,0,,ONES MORE EXPENSIVE.
Dialogue: 0,0:10:08.42,0:10:09.00,C,,0,0,0,,WHEN A RICH
Dialogue: 0,0:10:09.00,0:10:09.88,C,,0,0,0,,PERSON MAKES A
Dialogue: 0,0:10:09.88,0:10:10.70,C,,0,0,0,,MISTAKE,
Dialogue: 0,0:10:10.70,0:10:11.90,C,,0,0,0,,IT'S AN ANECDOTE.
Dialogue: 0,0:10:11.90,0:10:12.40,C,,0,0,0,,WHEN A POOR
Dialogue: 0,0:10:12.40,0:10:13.60,C,,0,0,0,,PERSON MAKES ONE,
Dialogue: 0,0:10:13.60,0:10:14.16,C,,0,0,0,,IT COMES WITH
Dialogue: 0,0:10:14.16,0:10:14.99,C,,0,0,0,,A LATE FEE.
Dialogue: 0,0:10:15.16,0:10:16.23,C,,0,0,0,,PLUS THIRTY-FIVE DOLLARS.
Dialogue: 0,0:10:16.68,0:10:17.38,C,,0,0,0,,SO MAYBE THE
Dialogue: 0,0:10:17.38,0:10:18.50,C,,0,0,0,,BETTER QUESTION ISN'T
Dialogue: 0,0:10:18.50,0:10:19.30,C,,0,0,0,,WHETHER POOR PEOPLE
Dialogue: 0,0:10:19.30,0:10:20.88,C,,0,0,0,,MAKE BAD DECISIONS.
Dialogue: 0,0:10:20.88,0:10:21.98,C,,0,0,0,,EVERYONE DOES.
Dialogue: 0,0:10:21.98,0:10:22.62,C,,0,0,0,,IT'S WHY SOME
Dialogue: 0,0:10:22.62,0:10:23.70,C,,0,0,0,,PEOPLE'S BAD DECISIONS
Dialogue: 0,0:10:23.70,0:10:24.44,C,,0,0,0,,COST SO MUCH
Dialogue: 0,0:10:24.44,0:10:24.99,C,,0,0,0,,MORE.
Dialogue: 0,0:10:25.13,0:10:25.65,C,,0,0,0,,TELL US IN
Dialogue: 0,0:10:25.65,0:10:26.43,C,,0,0,0,,THE COMMENTS WHAT
Dialogue: 0,0:10:26.43,0:10:26.95,C,,0,0,0,,YOU THINK.
Dialogue: 0,0:10:26.95,0:10:28.17,C,,0,0,0,,AND SUBSCRIBE.
Dialogue: 0,0:10:28.17,0:10:29.25,C,,0,0,0,,IT'S FREE,
Dialogue: 0,0:10:29.25,0:10:29.39,C,,0,0,0,,WHICH,
Dialogue: 0,0:10:29.39,0:10:30.47,C,,0,0,0,,AS WE'VE LEARNED,
Dialogue: 0,0:10:30.47,0:10:31.80,C,,0,0,0,,IS UNUSUALLY GENEROUS.
