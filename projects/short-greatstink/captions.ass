Dialogue: 0,0:00:00.40,0:00:00.98,C,,0,0,0,,IN THE SUMMER
Dialogue: 0,0:00:00.98,0:00:02.54,C,,0,0,0,,OF 1858,
Dialogue: 0,0:00:02.54,0:00:03.68,C,,0,0,0,,LONDON SMELLED SO
Dialogue: 0,0:00:03.68,0:00:04.44,C,,0,0,0,,BAD THAT THE
Dialogue: 0,0:00:04.44,0:00:05.36,C,,0,0,0,,NEWSPAPERS GAVE IT
Dialogue: 0,0:00:05.36,0:00:06.12,C,,0,0,0,,A NAME.
Dialogue: 0,0:00:06.12,0:00:07.39,C,,0,0,0,,THE GREAT STINK.
Dialogue: 0,0:00:07.59,0:00:08.57,C,,0,0,0,,A HEATWAVE HAD
Dialogue: 0,0:00:08.57,0:00:09.56,C,,0,0,0,,HIT THE CITY,
Dialogue: 0,0:00:09.56,0:00:10.54,C,,0,0,0,,AND THE RIVER
Dialogue: 0,0:00:10.54,0:00:11.53,C,,0,0,0,,THAMES WAS BASICALLY
Dialogue: 0,0:00:11.53,0:00:12.76,C,,0,0,0,,AN OPEN SEWER.
Dialogue: 0,0:00:13.04,0:00:14.12,C,,0,0,0,,LONDON HAD JUST
Dialogue: 0,0:00:14.12,0:00:15.16,C,,0,0,0,,FALLEN IN LOVE
Dialogue: 0,0:00:15.16,0:00:16.04,C,,0,0,0,,WITH THE FLUSHING
Dialogue: 0,0:00:16.04,0:00:17.42,C,,0,0,0,,TOILET.
Dialogue: 0,0:00:17.42,0:00:18.36,C,,0,0,0,,AND ALMOST ALL
Dialogue: 0,0:00:18.36,0:00:19.06,C,,0,0,0,,OF IT ENDED
Dialogue: 0,0:00:19.06,0:00:19.64,C,,0,0,0,,UP IN THE
Dialogue: 0,0:00:19.64,0:00:20.21,C,,0,0,0,,RIVER.
Dialogue: 0,0:00:20.43,0:00:21.39,C,,0,0,0,,WHICH WAS ALSO
Dialogue: 0,0:00:21.39,0:00:21.99,C,,0,0,0,,WHERE A LOT
Dialogue: 0,0:00:21.99,0:00:23.20,C,,0,0,0,,OF LONDONERS GOT
Dialogue: 0,0:00:23.20,0:00:24.48,C,,0,0,0,,THEIR DRINKING WATER.
Dialogue: 0,0:00:24.75,0:00:25.63,C,,0,0,0,,PLEASE TELL ME
Dialogue: 0,0:00:25.63,0:00:26.54,C,,0,0,0,,THEY FIXED THAT
Dialogue: 0,0:00:26.54,0:00:27.62,C,,0,0,0,,PART FIRST.
Dialogue: 0,0:00:27.85,0:00:28.71,C,,0,0,0,,RIGHT BESIDE THE
Dialogue: 0,0:00:28.71,0:00:29.53,C,,0,0,0,,RIVER STOOD THE
Dialogue: 0,0:00:29.53,0:00:30.55,C,,0,0,0,,BRAND NEW HOUSES
Dialogue: 0,0:00:30.55,0:00:31.55,C,,0,0,0,,OF PARLIAMENT.
Dialogue: 0,0:00:31.55,0:00:32.67,C,,0,0,0,,THE SMELL CAME
Dialogue: 0,0:00:32.67,0:00:33.73,C,,0,0,0,,IN THROUGH EVERY
Dialogue: 0,0:00:33.73,0:00:34.40,C,,0,0,0,,WINDOW.
Dialogue: 0,0:00:34.70,0:00:35.96,C,,0,0,0,,STAFF HUNG CURTAINS
Dialogue: 0,0:00:35.96,0:00:36.96,C,,0,0,0,,SOAKED IN CHEMICALS
Dialogue: 0,0:00:36.96,0:00:37.90,C,,0,0,0,,OVER THE WINDOWS
Dialogue: 0,0:00:37.90,0:00:38.58,C,,0,0,0,,TO BLOCK IT
Dialogue: 0,0:00:38.58,0:00:39.02,C,,0,0,0,,OUT.
Dialogue: 0,0:00:39.02,0:00:40.10,C,,0,0,0,,IT DID NOT
Dialogue: 0,0:00:40.10,0:00:40.79,C,,0,0,0,,WORK.
Dialogue: 0,0:00:41.05,0:00:41.99,C,,0,0,0,,BACK THEN,
Dialogue: 0,0:00:41.99,0:00:42.99,C,,0,0,0,,DOCTORS BELIEVED BAD
Dialogue: 0,0:00:42.99,0:00:44.35,C,,0,0,0,,SMELLS CAUSED DISEASES
Dialogue: 0,0:00:44.35,0:00:45.49,C,,0,0,0,,LIKE CHOLERA.
Dialogue: 0,0:00:45.49,0:00:46.30,C,,0,0,0,,SO THE POLITICIANS
Dialogue: 0,0:00:46.30,0:00:47.02,C,,0,0,0,,THOUGHT THE AIR
Dialogue: 0,0:00:47.02,0:00:47.89,C,,0,0,0,,ITSELF COULD KILL
Dialogue: 0,0:00:47.89,0:00:48.41,C,,0,0,0,,THEM.
Dialogue: 0,0:00:48.55,0:00:49.45,C,,0,0,0,,SUDDENLY,
Dialogue: 0,0:00:49.45,0:00:50.07,C,,0,0,0,,A SEWER PLAN
Dialogue: 0,0:00:50.07,0:00:50.57,C,,0,0,0,,THEY HAD PUT
Dialogue: 0,0:00:50.57,0:00:51.35,C,,0,0,0,,OFF FOR YEARS
Dialogue: 0,0:00:51.35,0:00:52.27,C,,0,0,0,,WAS APPROVED IN
Dialogue: 0,0:00:52.27,0:00:53.72,C,,0,0,0,,JUST EIGHTEEN DAYS.
Dialogue: 0,0:00:54.08,0:00:55.62,C,,0,0,0,,ENGINEER JOSEPH BAZALGETTE
Dialogue: 0,0:00:55.62,0:00:56.26,C,,0,0,0,,BUILT MORE THAN
Dialogue: 0,0:00:56.26,0:00:57.14,C,,0,0,0,,A THOUSAND MILES
Dialogue: 0,0:00:57.14,0:00:57.96,C,,0,0,0,,OF SEWERS UNDER
Dialogue: 0,0:00:57.96,0:00:58.53,C,,0,0,0,,LONDON.
Dialogue: 0,0:00:58.78,0:00:59.72,C,,0,0,0,,HE EVEN MADE
Dialogue: 0,0:00:59.72,0:01:00.80,C,,0,0,0,,THE PIPES BIGGER
Dialogue: 0,0:01:00.80,0:01:01.62,C,,0,0,0,,THAN THEY NEEDED
Dialogue: 0,0:01:01.62,0:01:02.10,C,,0,0,0,,TO BE,
Dialogue: 0,0:01:02.10,0:01:03.80,C,,0,0,0,,JUST IN CASE.
Dialogue: 0,0:01:03.80,0:01:04.62,C,,0,0,0,,MUCH OF HIS
Dialogue: 0,0:01:04.62,0:01:05.66,C,,0,0,0,,SYSTEM IS STILL
Dialogue: 0,0:01:05.66,0:01:06.73,C,,0,0,0,,WORKING TODAY.
Dialogue: 0,0:01:07.06,0:01:07.60,C,,0,0,0,,AND HERE'S THE
Dialogue: 0,0:01:07.60,0:01:08.40,C,,0,0,0,,TWIST.
Dialogue: 0,0:01:08.40,0:01:09.64,C,,0,0,0,,CHOLERA ACTUALLY SPREADS
Dialogue: 0,0:01:09.64,0:01:10.94,C,,0,0,0,,THROUGH DIRTY WATER,
Dialogue: 0,0:01:10.94,0:01:11.93,C,,0,0,0,,NOT BAD SMELLS.
Dialogue: 0,0:01:12.22,0:01:12.82,C,,0,0,0,,SO BY FIXING
Dialogue: 0,0:01:12.82,0:01:13.66,C,,0,0,0,,A SMELL,
Dialogue: 0,0:01:13.66,0:01:14.86,C,,0,0,0,,LONDON ACCIDENTALLY BEAT
Dialogue: 0,0:01:14.86,0:01:16.16,C,,0,0,0,,CHOLERA TOO.
Dialogue: 0,0:01:16.16,0:01:17.29,C,,0,0,0,,SUBSCRIBE FOR MORE.
